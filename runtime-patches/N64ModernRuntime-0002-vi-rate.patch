@@ -215,6 +215,17 @@ void ultramodern::sleep_milliseconds(uint32_t millis) {
 void ultramodern::sleep_until(const std::chrono::high_resolution_clock::time_point& time_point) {
     auto time_now = std::chrono::high_resolution_clock::now();
     if (time_point > time_now) {
+        // Sleep rounds up to the system timer period (1 to 15.6 ms), which at VI rates above 60 Hz wakes a whole
+        // VI late. A high-resolution waitable timer (Windows 10 1803 and later) wakes within about a millisecond.
+        thread_local HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+        if (timer != nullptr) {
+            LARGE_INTEGER due;
+            due.QuadPart = -std::chrono::duration_cast<std::chrono::nanoseconds>(time_point - time_now).count() / 100;
+            if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) {
+                WaitForSingleObject(timer, INFINITE);
+                return;
+            }
+        }
         long long delta_ms = std::chrono::ceil<std::chrono::milliseconds>(time_point - time_now).count();
         // printf("Sleeping %lld %d ms\n", delta_ms, (uint32_t)delta_ms);
         Sleep(delta_ms);
