+// A controller that comes back (a Bluetooth drop, a cable pulled and plugged in again) is a new SDL controller with a
+// new instance ID, while its player still holds the disconnected one. The player whose controller is disconnected and
+// has the same identity as the one that came back (the one its profile is kept under) gets the new one, instead of no
+// input until a restart, or in multiplayer mode joining as another player on its first press.
+void players::reconnect_controller(SDL_GameController* controller) {
+    uint64_t hash = profiles::get_guid_from_sdl_controller(controller).hash;
+    for (PlayerArray* player_array : { &PlayerState.players, &PlayerState.temp_players }) {
+        for (size_t i = 0; i < player_array->get_count(); i++) {
+            Player& player = (*player_array)[i];
+            if (player.controller != nullptr && !SDL_GameControllerGetAttached(player.controller) &&
+                profiles::get_guid_from_sdl_controller(player.controller).hash == hash) {
+                if (player_array == &PlayerState.players) {
+                    printf("  Back as player %zu's controller\n", i + 1);
+                }
+                player.controller = controller;
+                break;
+            }
+        }
+    }
+}
