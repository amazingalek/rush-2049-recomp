+    // A controller is matched to its saved profile by this hash, which leaves out the serial: a Bluetooth controller's
+    // serial can come out differently from one session to the next.
+    static uint64_t hash_controller_guid(const ControllerGUID &guid) {
+        XXH3_state_t state;
+        XXH3_64bits_reset(&state);
+        XXH3_64bits_update(&state, &guid.vendor, sizeof(guid.vendor));
+        XXH3_64bits_update(&state, &guid.product, sizeof(guid.product));
+        XXH3_64bits_update(&state, &guid.version, sizeof(guid.version));
+        XXH3_64bits_update(&state, &guid.crc16, sizeof(guid.crc16));
+        return XXH3_64bits_digest(&state);
+    }
