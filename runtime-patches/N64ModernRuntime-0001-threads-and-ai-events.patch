     uint32_t sample_count = byte_count / sizeof(int16_t);
diff --git a/ultramodern/src/events.cpp b/ultramodern/src/events.cpp
index 2f1cfb5..57e50bf 100644
--- a/ultramodern/src/events.cpp
+++ b/ultramodern/src/events.cpp
@@ -244,8 +244,30 @@ void vi_thread_func() {
                 remaining_retraces = cur_state->retrace_count;
             }
             if (events_context.ai.mq != NULLPTR) {
-                // Send a message to the VI queue, and do not set it to be requeued if the queue was full for the same reason as the VI message above.
-                ultramodern::enqueue_external_message_src(events_context.ai.mq, events_context.ai.msg, false, ultramodern::EventMessageSource::Ai);
+                // The AI interrupt fires each time the AI starts playing a queued buffer, so send one AI event per
+                // buffer's worth of audio played during this VI. A game that queues one buffer per frame gets about
+                // one event per VI; one that keeps a ring of short buffers gets several. Until the game has queued
+                // a buffer, send one per VI. Skip events while the host has plenty of audio queued, so that a
+                // host audio clock slower than this thread's doesn't build up latency without bound.
+                static double ai_bytes_played = 0.0;
+                uint32_t buffer_bytes = ultramodern::get_last_audio_buffer_bytes();
+                int events = 1;
+                if (buffer_bytes != 0) {
+                    double bytes_per_vi = ultramodern::get_audio_frequency() * 4.0 / (60 * ultramodern::get_speed_multiplier());
+                    ai_bytes_played += bytes_per_vi;
+                    events = 0;
+                    while (ai_bytes_played >= buffer_bytes) {
+                        ai_bytes_played -= buffer_bytes;
+                        events++;
+                    }
+                    if (ultramodern::get_remaining_audio_bytes() > 8 * bytes_per_vi) {
+                        events = 0;
+                    }
+                }
+                for (int i = 0; i < events; i++) {
+                    // Requeued only if the game asked for it (MessageQueueControl), for the reason of the VI message above.
+                    ultramodern::enqueue_external_message_src(events_context.ai.mq, events_context.ai.msg, false, ultramodern::EventMessageSource::Ai);
+                }
             }
         }
 
