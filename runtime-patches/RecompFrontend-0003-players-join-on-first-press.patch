+// A controller player has no keyboard, except player 1 while nobody has the keyboard: every player starts out on the
+// single-player keyboard profile, which would make the keyboard drive them all.
+static void set_controller_player_profiles(int player_index, SDL_GameController* controller, bool keyboard_assigned) {
+    int cont_profile_index = profiles::get_controller_profile_index_from_sdl_controller(controller);
+    if (cont_profile_index >= 0) {
+        profiles::set_input_profile_for_player(player_index, cont_profile_index, InputDevice::Controller);
+    }
+    int kb_profile_index = (player_index == 0 && !keyboard_assigned) ? profiles::get_sp_keyboard_profile_index() : -1;
+    profiles::set_input_profile_for_player(player_index, kb_profile_index, InputDevice::Keyboard);
+}
