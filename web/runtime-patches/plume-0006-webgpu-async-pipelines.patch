-    WebGPUBuffer::~WebGPUBuffer() {
-        if (mapped) {
-            auto &mappedBuffers = device->mappedBuffers;
-            mappedBuffers.erase(std::remove(mappedBuffers.begin(), mappedBuffers.end(), this), mappedBuffers.end());
