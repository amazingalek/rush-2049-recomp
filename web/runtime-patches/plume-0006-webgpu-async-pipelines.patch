+        UnwrappedDescriptorSetDesc(const RenderDescriptorSetDesc &source) : desc(source) {
+            ranges.assign(source.descriptorRanges, source.descriptorRanges + source.descriptorRangesCount);
+            samplers.resize(ranges.size());
