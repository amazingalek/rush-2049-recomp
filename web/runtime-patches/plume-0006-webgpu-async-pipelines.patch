+    // Runs f on the device thread and returns what it returned.
+    template<typename F>
+    static auto runSync(DeviceThread *thread, F &&f) -> decltype(f()) {
+        using Result = decltype(f());
+        if constexpr (std::is_void_v<Result>) {
+            thread->runSync(f);
+        }
+        else {
+            Result result{};
+            thread->runSync([&]() { result = f(); });
+            return result;
+        }
+    }
