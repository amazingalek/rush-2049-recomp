+        // Rush 2049 patch: a viewport whose left and right edges follow different origins (gEXSetViewportAlignEdges).
+        // Where an origin sits on a framebuffer fbWidth wide, as RT64 places rects and scissors.
+        static float originX(uint16_t origin, int32_t fbWidth, float extOriginPercentage) {
+            return (float(fbWidth) * origin / 0x400) * extOriginPercentage + (float(fbWidth) / 2.0f) * (1.0f - extOriginPercentage);
+        }
+
+        static bool hasStretchedEdges(uint16_t leftOrigin, uint16_t rightOrigin) {
+            return (leftOrigin < 0x800) && (rightOrigin < 0x800) && (leftOrigin != rightOrigin);
+        }
+
+        // The left edge in native pixels, on a framebuffer aspectRatioScale times wider than fbWidth.
+        float stretchedLeft(uint16_t leftOrigin, int32_t fbWidth, float aspectRatioScale, float extOriginPercentage) const {
+            const float origin = originX(leftOrigin, fbWidth, extOriginPercentage);
+            return origin * aspectRatioScale + (translate.x - std::abs(scale.x)) - origin;
+        }
+
+        // How many times wider than the game set it the viewport is drawn, with each edge moved with its origin.
+        float edgeStretch(uint16_t leftOrigin, uint16_t rightOrigin, int32_t fbWidth, float aspectRatioScale, float extOriginPercentage) const {
+            const float width = 2.0f * std::abs(scale.x);
+            const float moved = originX(rightOrigin, fbWidth, extOriginPercentage) - originX(leftOrigin, fbWidth, extOriginPercentage);
+            return (width > 0.0f) ? (1.0f + moved * (aspectRatioScale - 1.0f) / width) : 1.0f;
+        }
+
         float minDepth() const {
             return translate.z - scale.z;
         }
