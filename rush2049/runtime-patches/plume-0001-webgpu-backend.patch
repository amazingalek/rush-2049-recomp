+    void WebGPUSwapChain::getCanvasSize(uint32_t &width, uint32_t &height) const {
+        int canvasWidth = 0, canvasHeight = 0;
+        emscripten_get_canvas_element_size(selector.c_str(), &canvasWidth, &canvasHeight);
