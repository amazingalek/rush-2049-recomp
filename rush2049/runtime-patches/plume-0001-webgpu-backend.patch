diff --git a/examples/cmake/modules/PlumeWGSL.cmake b/examples/cmake/modules/PlumeWGSL.cmake
new file mode 100644
index 0000000..13baeba
--- /dev/null
+++ b/examples/cmake/modules/PlumeWGSL.cmake
@@ -0,0 +1,39 @@
+# PlumeWGSL.cmake
+# Script mode (cmake -P): turns a SPIR-V shader into WGSL for plume's WebGPU backend and embeds it as C.
+#
+#   cmake -DNAGA=<naga> -DINPUT=<shader.spirv> -DOUTPUT=<shader.wgsl> -DVAR_NAME=<name>
+#         -DOUTPUT_C=<file.c> -DOUTPUT_H=<file.h> -P PlumeWGSL.cmake
+#
+# naga reads the SPIR-V that dxc writes for Vulkan. --keep-coordinate-space stops it negating the vertex position's y,
+# because the shader is compiled without -fvk-invert-y: WebGPU's clip space is D3D's. naga declares the push
+# constant block as var<immediate> (var<push_constant> before naga 30), which core WebGPU doesn't have, so the line
+# becomes the uniform buffer plume_webgpu.h puts push constants in, @group(3) @binding(0).
+
+foreach(ARG NAGA INPUT OUTPUT VAR_NAME OUTPUT_C OUTPUT_H)
+    if(NOT DEFINED ${ARG})
+        message(FATAL_ERROR "PlumeWGSL.cmake needs -D${ARG}=...")
+    endif()
+endforeach()
+
+execute_process(
+    COMMAND "${NAGA}" --input-kind spv --keep-coordinate-space "${INPUT}" "${OUTPUT}"
+    RESULT_VARIABLE NAGA_RESULT
+    OUTPUT_VARIABLE NAGA_OUTPUT
+    ERROR_VARIABLE NAGA_OUTPUT
+)
+if(NOT NAGA_RESULT EQUAL 0)
+    message(FATAL_ERROR "naga failed on ${INPUT}:\n${NAGA_OUTPUT}")
+endif()
+
+file(READ "${OUTPUT}" WGSL)
+string(REGEX REPLACE "var<(immediate|push_constant)>" "@group(3) @binding(0) var<uniform>" WGSL "${WGSL}")
+file(WRITE "${OUTPUT}" "${WGSL}")
+
+# The same layout as plume_file_to_c's, with the text zero-terminated.
+file(READ "${OUTPUT}" HEX HEX)
+string(LENGTH "${HEX}" HEX_LENGTH)
+math(EXPR SIZE "${HEX_LENGTH} / 2 + 1")
+string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
+string(REGEX REPLACE "((0x..,){32})" "\\1\n    " BYTES "${BYTES}")
+file(WRITE "${OUTPUT_C}" "// Auto-generated by PlumeWGSL.cmake - do not edit\n\n#include <stddef.h>\n\nconst char ${VAR_NAME}[${SIZE}] = {\n    ${BYTES}0x00\n};\n\nconst size_t ${VAR_NAME}_size = ${SIZE};\n")
+file(WRITE "${OUTPUT_H}" "// Auto-generated by PlumeWGSL.cmake - do not edit\n\n#pragma once\n\n#include <stddef.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\nextern const char ${VAR_NAME}[${SIZE}];\nextern const size_t ${VAR_NAME}_size;\n\n#ifdef __cplusplus\n}\n#endif\n")
